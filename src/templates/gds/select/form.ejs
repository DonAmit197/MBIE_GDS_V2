

{% 
  
  if (!ctx.component.customOptions || typeof ctx.component.customOptions !== 'object') {
    ctx.component.customOptions = {};
  }

  ctx.component.customOptions.labelId = 'l-' + ctx.instance.id + '-' + ctx.component.key;
  if(ctx.instance && ctx.instance.choices && ctx.instance.choices.containerInner ){
    if(ctx.instance.choices.containerInner.element.tabindex=== "0"){
      ctx.instance.choices.containerInner.element.tabindex = "-1";
    }
  }
%}


<select ref="{{ctx.input.ref ? ctx.input.ref : 'selectContainer'}}"
        {{ ctx.input.multiple ? 'multiple' : '' }}
{% for (var attr in ctx.input.attr) { %}
{{attr}}="{{ctx.input.attr[attr]}}{% if (attr==='class') { %} govuk-select {% } %}"
{% } %}
>{{ctx.selectOptions}}</select>